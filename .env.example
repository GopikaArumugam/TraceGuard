# LLM Provider Configuration
OPENAI_API_KEY=your-openai-api-key-here
# Optional: Swap to Claude or Gemini by configuring keys below:
# ANTHROPIC_API_KEY=your-anthropic-key-here
# GEMINI_API_KEY=AQ.Ab8RN6JPKLVb-U3U13MftDfWjTOandmAY0Z2NXwS9duOwSxsZw

# Database Configuration
# Default is SQLite for easy local runs. Set to a postgres URL to use PostgreSQL.
DATABASE_URL=sqlite:///./audit_logs.db

# API Port & Host
API_HOST=0.0.0.0
API_PORT=8000
